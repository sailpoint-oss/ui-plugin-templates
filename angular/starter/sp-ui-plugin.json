{
  "version": 1,
  "manifest": {
    "alias": "paul-starter",
    "name": {
      "en": "paul-starter"
    },
    "description": {
      "en": "Angular starter used for testing in the pdavis tenant."
    },
    "apiScopes": ["sp:scopes:all"],
    "permissionPolicy": {},
    "iframeAllow": {},
    "iframeSandbox": [],
    "contentSecurityPolicies": {},
    "slots": [
      {
        "slotId": "full-page"
      }
    ],
    "state": "ENABLED"
  },
  "build": {
    "outDir": "./dist/starter/browser",
    "port": 4200
  }
}
